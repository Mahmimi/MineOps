apiVersion: v1
kind: Secret
metadata:
  name: discord-bot-secret
  namespace: mineops
  labels:
    app.kubernetes.io/name: discord-bot
    app.kubernetes.io/component: chatops
    app.kubernetes.io/part-of: mineops
    app.kubernetes.io/managed-by: local-bootstrap
type: Opaque
stringData:
  token: "replace-with-discord-bot-token"
  client-id: "replace-with-discord-application-client-id"
  guild-id: ""
